# --------------------------------------------------
# Terraform
# --------------------------------------------------

# Terraform working directory
.terraform/
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plans
*.tfplan
*.plan

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example
!*.tfvars.json.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE:
# Keep .terraform.lock.hcl in Git.


# --------------------------------------------------
# Ansible / Kubespray
# --------------------------------------------------

*.retry
*.log
ansible.log

# Ansible local cache
.ansible/

# Ansible Vault password files
.vault_pass
.vault-password
.vault-password-file
vault-password
vault-password.txt
vault-pass.txt


# --------------------------------------------------
# Kubernetes
# --------------------------------------------------

# Generated kubeconfig files
kubeconfig
kubeconfig.yaml
kubeconfig-*
*.kubeconfig

# Kubernetes certificates and private credentials
*.key
*.pem
*.p12
*.pfx

# Kubernetes service account tokens
*-token


# --------------------------------------------------
# SSH keys
# --------------------------------------------------

id_rsa
id_ed25519
*_rsa
*_ed25519

# SSH public keys
*.pub


# --------------------------------------------------
# Cloud-init / temporary files
# --------------------------------------------------

# Repository-local temporary working directory
/tmp/
tmp/

# Temporary and generated files
*.tmp
*.temp
*.swp
*.bak
*~


# --------------------------------------------------
# Python
# --------------------------------------------------

__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/


# --------------------------------------------------
# Environment variables and credentials
# --------------------------------------------------

.env
.env.*
!.env.example

# Common local credential files
credentials.json
service-account.json


# --------------------------------------------------
# Editor / IDE
# --------------------------------------------------

.vscode/
.idea/


# --------------------------------------------------
# Operating system
# --------------------------------------------------

.DS_Store
Thumbs.db
